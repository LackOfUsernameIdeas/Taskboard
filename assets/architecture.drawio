        </mxCell>
        <mxCell id="a108" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFB366;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontStyle=0;opacity=45;strokeColor=#000000;" value="&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;This service exposes the REST API for registering users, logging in, and managing tasks. Every request is authenticated with JWT, and errors come back as clean, predictable JSON (Global Exception Handler)&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="560" x="120" y="420" as="geometry" />
        </mxCell>
        <mxCell id="a109" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;fontSize=14;fontStyle=0;opacity=100;strokeColor=#8C8C8C;" value="" vertex="1">
