        </mxCell>
        <mxCell id="a110" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E07000;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fontSize=24;fontStyle=1;opacity=100;strokeColor=#000000;" value="taskboard-worker  ·  no port" vertex="1">
          <mxGeometry height="60" width="560" x="760" y="360" as="geometry" />
        </mxCell>
        <mxCell id="a111" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFB366;fontColor=#000000;align=center;verticalAlign=middle;spacing=8;fontSize=20;fontStyle=0;opacity=45;strokeColor=#000000;" value="&lt;div style=&quot;line-height: 160%;&quot;&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;This service runs quietly in the background. Every 60 seconds, it checks the database for tasks that are overdue and logs them – it never modifies any data&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="200" width="560" x="760" y="420" as="geometry" />
        </mxCell>
        <mxCell id="a112" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E07000;fontColor=#FFFFFF;align=center;verticalAlign=middle;spacing=8;fontSize=24;fontStyle=1;opacity=100;strokeColor=#000000;" value="taskboard-core" vertex="1">
